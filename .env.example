# ParkAP environment — copy to .env and fill in.
# Every variable here is validated by a Zod schema at boot (apps/*/src/config/env.ts).
# The app refuses to start on a missing or malformed value. That is deliberate.

# ─────────────────────────────────────────────────────────────
# Shared
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Database — Neon Postgres (a personal dev branch locally, main in prod)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/parkap?sslmode=require
# Unpooled connection, used by `prisma migrate`. Neon gives you both.
DIRECT_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/parkap?sslmode=require

# ─────────────────────────────────────────────────────────────
# Cache & queues — Upstash Redis
# Holds, rate limits, Socket.IO adapter, BullMQ.
# ─────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# ─────────────────────────────────────────────────────────────
# apps/api
# ─────────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated origins allowed to call the api with credentials.
API_CORS_ORIGINS=http://localhost:3000
# Signs QR ticket tokens. Minimum 32 chars. Rotate = every live ticket invalidated.
TICKET_TOKEN_SECRET=change-me-to-a-long-random-string-min-32-chars
# Minutes a reservation hold survives without payment.
BOOKING_HOLD_TTL_MINUTES=10

# Provider seams. `stub`/`mock` throw on boot when NODE_ENV=production.
OTP_PROVIDER=stub
PAYMENT_PROVIDER=mock

# ─────────────────────────────────────────────────────────────
# apps/web
# ─────────────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Better Auth (apps/web owns sessions; the api only verifies).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Optional — map view degrades to a list without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# apps/worker
# ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─────────────────────────────────────────────────────────────
# Observability — all optional; the SDKs no-op when unset.
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_POSTHOG_KEY=

# Demo mode: skip the sign-in screen and run as one fixed citizen.
# Refuses to run when NODE_ENV=production. Never enable on a deployment.
DEMO_AUTO_SIGN_IN=false
