{
  "name": "@parkap/worker",
  "version": "0.1.0",
  "private": true,
  "description": "ParkAP background workers — ticket issue, notifications, invoices, snapshots.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@parkap/shared": "*",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^10.69.0",
    "bullmq": "^5.34.6",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
